#!/bin/bash
# ripdep - Deployment and operations tool
# Primary location: Local dev machine
# Copied to VMs during deployment for 'install' command

set -euo pipefail

# ============================================ 
# CONFIGURATION
# ============================================ 

# Base directory on remote hosts for staging deployments.
REMOTE_BASE_DIR="/tmp"
# Local directory for storing final release artifacts (tarballs).
RELEASES_BASE_DIR="${HOME}/src/backup/releases"
# Directory for hook scripts that can be run at different stages.
HOOKS_DIR="${HOME}/src/restinpieces-litestream/hooks"

# Filename of the age identity file. Created locally with ripc, required in project dir, deployed to app home.
AGE_KEY_FILENAME="age.key"
# Canonical project database filenames. No other "app.db" or ".db" literals allowed.
APP_DB_FILENAME="app.db"
DB_SUFFIX=".db"

# Canonical app layout directory names. Shared by local build artifacts and the
# remote install, which both expect bin/, data/ (and logs/ on the remote host).
APP_BIN_DIRNAME="bin"
APP_DATA_DIRNAME="data"
APP_LOGS_DIRNAME="logs"

# Placeholder in systemd templates, replaced with the project name.
# @...@ syntax is used because systemd expands $VAR/${VAR} itself in ExecStart.
SYSTEMD_APP_PLACEHOLDER="@RESTINPIECES_APP@"
# Filename of the systemd file: looked up in the project directory, otherwise
# downloaded from URL_TEMPLATE_SYSTEMD. Copied into the build dir under
# SYSTEMD_FILENAME_TEMPLATE.
SYSTEMD_FILENAME="systemd.service"
# Filename pattern of the rendered systemd conf in a build dir. Shared with the
# remote installer, which searches for the same pattern. Matches the installed
# unit name, /etc/systemd/system/<project>.service, so no rename is needed.
SYSTEMD_FILENAME_TEMPLATE="%s.service"

# Host architecture (actual build machine - always correct)
HOST_GOOS=$(go env GOHOSTOS)
HOST_GOARCH=$(go env GOHOSTARCH)

# Target architecture (deployment machine - where binaries will run)
TARGET_GOOS=${GOOS:-$HOST_GOOS}
TARGET_GOARCH=${GOARCH:-$HOST_GOARCH}

# Toold URL Templates
URL_TEMPLATE_SYSTEMD="https://raw.githubusercontent.com/caasmo/restinpieces/master/${SYSTEMD_FILENAME}"

# SQLite: %s=os, %s=arch, %s=version
URL_TEMPLATE_SQLITE="https://sqlite.org/2025/sqlite-tools-%s-%s-3510100.zip"

# Filename template for the tarball
TARBALL_FILENAME_TEMPLATE="%s-%s.tar.gz"

# Colors for output
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'
NC=$'\033[0m' # No Color

# ============================================ 
# UTILITY FUNCTIONS
# ============================================ 

log_info() {
    echo -e "${BLUE}→${NC} $1"
}

log_success() {
    echo -e "${GREEN}✓${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

log_error() {
    echo -e "${RED}✗${NC} $1" >&2
}



require_root() {
    if [ $EUID -ne 0 ]; then
        log_error "This command must run as root (use sudo)"
        exit 1
    fi
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || { log_error "Required command not found: $1"; exit 1; }
}

# get_latest_tag: returns the last tag reachable from HEAD.
# Echos the tag on success and returns 0.
# On failure, logs an error and returns 1.
get_latest_tag() {
    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        log_error "Not a git repository. Cannot determine version."
        return 1
    fi

    local tag
    if ! tag=$(git describe --tags --abbrev=0 2>/dev/null); then
        log_error "No tag found."
        return 1
    fi

    echo "$tag"
    return 0
}

get_project_name_from_file_base() {
    # This function extracts the project name from a string like "my-project-v1.0".
    # It assumes the format is "<project-name>-<version>".
    #
    # The magic is "%-*" (Shortest Suffix Removal). It finds the LAST hyphen
    # and removes it and everything after it, leaving the project name.
    # Example: "my-project-with--v0.1" % "-*" --> "my-project-with-"
    local input_string="$1"
    echo "${input_string%-*}"
}

get_version_from_file_base() {
    # This function extracts the version from a string like "my-project-v1.0".
    # It assumes the format is "<project-name>-<version>".
    #
    # The magic is "##*-" (Longest Prefix Removal). It finds everything from
    # the start of the string up to and including the LAST hyphen. It removes
    # this prefix, leaving only the version string.
    # Example: "my-project-with--v0.1" ## "*-" --> "v0.1"
    local input_string="$1"
    echo "${input_string##*-}"
}

get_remote_dir_from_tarball_path() {
    local tarball_path=$1
    local tarball_name
    tarball_name=$(basename "$tarball_path")
    local tar_base="${tarball_name%.tar.gz}"

    local project_name
    project_name=$(get_project_name_from_file_base "$tar_base")
    local version
    version=$(get_version_from_file_base "$tar_base")

    if [ -z "$project_name" ] || [ -z "$version" ]; then
        log_error "Could not parse project name and version from tarball: ${tarball_name}"
        log_error "Expected format: <project-name>-<version>.tar.gz"
        return 1
    fi

    echo "${REMOTE_BASE_DIR}/${project_name}/${version}"
}

# get_bin_dir: echoes the standard bin/ subdirectory path under a given directory.
get_bin_dir() {
    local dir=$1
    echo "${dir}/${APP_BIN_DIRNAME}"
}

# get_data_dir: echoes the standard data/ subdirectory path under a given directory.
get_data_dir() {
    local dir=$1
    echo "${dir}/${APP_DATA_DIRNAME}"
}

# seems_build_dir: returns 0 if the directory has bin/ and data/ subdirs.
seems_build_dir() {
    local dir=$1
    [ -d "$(get_bin_dir "$dir")" ] && [ -d "$(get_data_dir "$dir")" ]
}

# is_go_project: Checks if a given path is a valid Go project for this script.
# Returns 0 if it is, 1 otherwise.
is_go_project() {
    local project_path=$1
    if [ ! -d "$project_path" ]; then
        log_error "Project path does not exist or is not a directory: ${project_path}"
        return 1
    fi
    if [ ! -f "${project_path}/go.mod" ]; then
        log_error "Not a Go project (missing go.mod): ${project_path}"
        return 1
    fi
    # The build logic relies on a cmd/ dir.
    if [ ! -d "${project_path}/cmd" ]; then
        log_error "No cmd/ directory found in project: ${project_path}"
        return 1
    fi
    return 0
}

# require_clean_worktree: fails unless tracked files have no uncommitted changes
# and HEAD is exactly on the last tag. Untracked files are allowed.
# Returns 0 if clean and tagged, 1 otherwise.
require_clean_worktree() {
    local project_path=$1
    local changes

    if ! changes=$(cd "$project_path" && git status --porcelain --untracked-files=no); then
        log_error "Failed to read git status in project: ${project_path}"
        return 1
    fi

    if [ -n "$changes" ]; then
        log_error "Worktree is not clean: ${project_path}"
        return 1
    fi

    local tag
    if ! tag=$(cd "$project_path" && get_latest_tag); then
        return 1
    fi

    local head
    head=$(cd "$project_path" && git rev-parse HEAD)

    local tag_commit
    tag_commit=$(cd "$project_path" && git rev-parse "${tag}^{commit}")

    if [ "$head" != "$tag_commit" ]; then
        log_error "HEAD is not on tag ${tag}: ${project_path}"
        return 1
    fi

    return 0
}

# require_age_key: Checks project dir contains the age identity file.
# Returns 0 if present, 1 otherwise.
require_age_key() {
    local project_path=$1
    if [ ! -f "${project_path}/${AGE_KEY_FILENAME}" ]; then
        log_error "${AGE_KEY_FILENAME} not found in project: ${project_path}/${AGE_KEY_FILENAME}"
        return 1
    fi
    return 0
}

# copy_age_key: copies the project's age key into the build dir.
# Exits with an error if the project has no age key.
copy_age_key() {
    local project_path=$1
    local build_dir=$2

    if ! require_age_key "$project_path"; then
        exit 1
    fi
    log_info "Using existing age key from project: ${project_path}/${AGE_KEY_FILENAME}"
    cp "${project_path}/${AGE_KEY_FILENAME}" "${build_dir}/${AGE_KEY_FILENAME}"
    log_success "Added age key to ${build_dir}/${AGE_KEY_FILENAME}"
}

# ============================================ 
# DEPLOYMENT FUNCTIONS - LOCAL
# ============================================ 

recreate_build_dir() {
    local build_dir=$1
    local bin_dir
    bin_dir=$(get_bin_dir "$build_dir")
    local data_dir
    data_dir=$(get_data_dir "$build_dir")
    
    # Clean and create
    if [ -d "$build_dir" ]; then
        log_info "Deleting old build directory: $build_dir"
        rm -rf "$build_dir"
    fi
    mkdir -p "$bin_dir"
    mkdir -p "$data_dir"
    
    log_info "Build directory created: $build_dir"
}

build_project_binary() {
    require_command go
    local bin_dir=$1 project_path=$2 binary_name=$3
    local project_name
    project_name=$(basename "$project_path")

    log_info "Building Go restinpieces app binaries ${GREEN}${TARGET_GOOS}/${TARGET_GOARCH}${NC} from project: $project_path"

    local num_commands
    num_commands=$(ls -d "$project_path"/cmd/*/ 2>/dev/null | wc -l)
    local src=""

    if [ -d "$project_path/cmd/$project_name" ]; then
        src="./cmd/$project_name"
    elif [ "$num_commands" -eq 1 ]; then
        # Get the single cmd subdirectory
        local full_path
        full_path=$(ls -d "$project_path"/cmd/*/ 2>/dev/null)
        local cmd_name
        cmd_name=$(basename "$full_path")
        src="./cmd/$cmd_name"
    else
        log_error "Build failed: Multiple dirs in cmd/ but none match '${project_name}', or cmd/ is empty."
        exit 1
    fi
    
    # Build from the project directory.
    # We use a subshell (...) to change into the project dir for the build (so go.mod is found)
    # without affecting the current working directory of this script.
    (cd "$project_path" && go build -ldflags="-s -w" -trimpath -o "${bin_dir}/${binary_name}" "$src")
    log_success "Built ${binary_name} in ${bin_dir}"
}

# Install ripc from the version pinned in the project's go.mod.
build_ripc() {
    require_command go
    local bin_dir=$1
    local project_path=$2

    local ripc_version
    if ! ripc_version=$(cd "$project_path" && go list -m -f '{{.Version}}' github.com/caasmo/restinpieces); then
        log_error "Could not determine the restinpieces version pinned in ${project_path}/go.mod"
        exit 1
    fi

    log_info "Installing ripc ${ripc_version}..."
    GOBIN="$bin_dir" go install "github.com/caasmo/restinpieces/cmd/ripc@${ripc_version}"
    log_success "Ripc binary placed in ${bin_dir}/ripc"
}

# Download and install SQLite tools
download_sqlite() {
    require_command curl
    require_command unzip
    local dest_dir=$1
    local os=${2:-$HOST_GOOS}
    local arch=${3:-$HOST_GOARCH}
    local tmp_zip

    # SQLite uses 'x64' for 'amd64'
    if [ "$arch" == "amd64" ]; then arch="x64"; fi

    local url_sqlite
    printf -v url_sqlite "$URL_TEMPLATE_SQLITE" "$os" "$arch"
    
    log_info "Downloading SQLite tools from $url_sqlite..."
    
    # Create temporary file inside the given destination directory
    tmp_zip=$(TMPDIR=${dest_dir} mktemp --suffix=.zip)
    
    # Download SQLite tools
    if ! curl -sSLf "$url_sqlite" -o "$tmp_zip"; then
        log_error "Failed to download SQLite tools from $url_sqlite" >&2
        return 1
    fi
    
    # Extract sqlite3 binary to bin_dir
    if ! unzip -p "$tmp_zip" "sqlite3" > "${dest_dir}/sqlite3"; then
        log_error "Failed to extract sqlite3 from archive" >&2
        return 1
    fi
    
    # Make executable
    chmod +x "${dest_dir}/sqlite3"
    
    log_success "SQLite tools downloaded to ${dest_dir}/sqlite3"
}

# find_project_db: locates the project database, never creates.
# Checks <project_name>.db first, then app.db fallback.
# Echoes full path if found, echoes "" if none.
find_project_db() {
    local project_path=$1
    local project_name=$2
    local candidate="${project_path}/${project_name}${DB_SUFFIX}"
    if [ -f "$candidate" ]; then
        echo "$candidate"
        return 0
    fi
    candidate="${project_path}/${APP_DB_FILENAME}"
    if [ -f "$candidate" ]; then
        echo "$candidate"
        return 0
    fi
    echo ""
}

# require_project_db: locates the project database or fails.
# Echoes the full path if found, returns 1 otherwise.
require_project_db() {
    local project_path=$1
    local project_name=$2

    local source_db
    source_db=$(find_project_db "$project_path" "$project_name")
    if [ -z "$source_db" ]; then
        log_error "No project database found in ${project_path}: tried ${project_name}${DB_SUFFIX} and ${APP_DB_FILENAME}"
        return 1
    fi
    echo "$source_db"
}

# copy_project_db: copies the project database into the build's data/ directory.
# Exits with an error if the project has no database.
copy_project_db() {
    require_command sqlite3
    local project_path=$1
    local project_name=$2
    local data_dir=$3

    local source_db
    if ! source_db=$(require_project_db "$project_path" "$project_name"); then
        exit 1
    fi
    log_info "Found project database: $source_db"
    sqlite3 "$source_db" ".backup '${data_dir}/${APP_DB_FILENAME}'"
    log_success "Backed up $(basename "$source_db") to ${data_dir}/${APP_DB_FILENAME}"
}

create_logs_db() {
    log_warning "log.db not activated, TODO"
}

# get_systemd_template: copies the systemd template from the project directory, or
# downloads the generic template, into the destination conf file.
get_systemd_template() {
    local project_path=$1
    local dest_conf_file=$2

    local local_template_path="${project_path}/${SYSTEMD_FILENAME}"

    if [ -f "$local_template_path" ]; then
        log_info "Found local systemd template at: $local_template_path"
        cp "$local_template_path" "$dest_conf_file"
        log_success "Copied local systemd template to $dest_conf_file"
        return 0
    fi

    log_warning "Local systemd template not found at: $local_template_path"
    log_info "Downloading systemd template from $URL_TEMPLATE_SYSTEMD..."
    if ! curl -sSLf "$URL_TEMPLATE_SYSTEMD" -o "$dest_conf_file"; then
        log_error "Failed to download systemd template from $URL_TEMPLATE_SYSTEMD"
        exit 1
    fi
    log_success "Downloaded systemd template to $dest_conf_file"
}

# render_systemd_template: replaces every SYSTEMD_APP_PLACEHOLDER with the project name.
render_systemd_template() {
    local conf_file=$1
    local project_name=$2

    local content
    content=$(<"$conf_file")
    printf '%s\n' "${content//"$SYSTEMD_APP_PLACEHOLDER"/$project_name}" > "$conf_file"
}

# validate_systemd_conf: fails if the project name is missing from the rendered conf.
validate_systemd_conf() {
    local conf_file=$1
    local project_name=$2

    if ! grep -qF "$project_name" "$conf_file"; then
        log_error "Validation failed: project name '${project_name}' not found in ${conf_file}"
        exit 1
    fi
}

# create_systemd_conf: obtains, renders, and validates the project's systemd conf
# inside the build dir.
create_systemd_conf() {
    local project_name=$1
    local project_path=$2
    local build_dir=$3

    log_info "Adding Systemd configuration..."

    local conf_filename
    printf -v conf_filename "$SYSTEMD_FILENAME_TEMPLATE" "$project_name"
    local dest_conf_file="${build_dir}/${conf_filename}"

    get_systemd_template "$project_path" "$dest_conf_file"
    render_systemd_template "$dest_conf_file" "$project_name"
    validate_systemd_conf "$dest_conf_file" "$project_name"

    log_success "Created systemd conf at $dest_conf_file"
}



# cmd_pack: Packages a build directory into a release tarball.
#
# General Purpose:
# This function takes a completed build directory and creates a compressed tarball (.tar.gz).
# The resulting tarball is placed in the standard releases directory, defined by
# the RELEASES_BASE_DIR variable (e.g., ~/src/backup/releases/<project_name>/).
#
# Tarball Naming:
# The name of the output tarball is primarily determined by the main project binary found
# in the build directory's 'bin/' subfolder. It includes the project name and the Git tag version.
# The tarball overwrites any existing file with the same name.
#
# Example Tarball Name:
# myproject-v1.2.3.tar.gz
cmd_pack() {
    local build_dir=$1

    if [ -z "$build_dir" ] || [ ! -d "$build_dir" ]; then
        log_error "Usage: $0 pack <build_dir>"
        log_error "A valid build directory must be provided."
        exit 1
    fi

    if ! seems_build_dir "$build_dir"; then
        log_error "Directory '${build_dir}' does not appear to be a valid build directory. Missing 'bin' or 'data'."
        exit 1
    fi
    
    log_info "Packing build directory: ${build_dir}"

    local build_name
    build_name=$(basename "$build_dir") 

    local project_name
    project_name=$(get_project_name_from_file_base "$build_name")

    local tarball_name="${build_name}.tar.gz"
    
    local output_dir="${RELEASES_BASE_DIR}/${project_name}"
    mkdir -p "$output_dir"
    
    local output_path="${output_dir}/${tarball_name}"
    
    log_info "Creating tarball: ${output_path}"
    if ! tar -czf "$output_path" -C "$build_dir" .; then
         log_error "Failed to create tarball."
         exit 1
    fi
    
    local size
    size=$(du -h "$output_path" | cut -f1)
    log_success "Created release artifact: ${output_path} (${size})"

    if [ -z "${CMD_DEPLOY_CALLER:-}" ]; then
        echo "" # Add a blank line for readability
        log_info "Next step: Push the artifact to a remote host:"
        log_info "    $0 push <host> ${output_path}"
    fi
}

# cmd_unpack: Extracts a release tarball into a directory.
cmd_unpack() {
    local tarball_path=$1
    local target_dir=$2

    if [ -z "$tarball_path" ] || [ -z "$target_dir" ]; then
        log_error "Usage: $0 unpack <tarball_path> <target_dir>"
        exit 1
    fi

    if [ ! -f "$tarball_path" ]; then
        log_error "Release tarball not found: $tarball_path"
        exit 1
    fi

    mkdir -p "$target_dir"
    log_info "Unpacking ${tarball_path} to ${target_dir}..."
    
    if ! tar -xzf "$tarball_path" -C "$target_dir"; then
        log_error "Failed to unpack tarball."
        exit 1
    fi
    
    log_success "Unpacked release to ${target_dir}"
}

# cmd_restore_db: Restores a database from a source into a directory.
cmd_restore_db() {
    local source=$1
    local target_dir=$2

    if [ -z "$source" ] || [ -z "$target_dir" ]; then
        log_error "Usage: $0 restore-db <source> <target_dir>"
        exit 1
    fi

    local data_dir
    data_dir=$(get_data_dir "$target_dir")
    mkdir -p "$data_dir"

    if [[ "$source" == *.db ]]; then
        log_info "Copying database file: ${source}..."
        cp "$source" "${data_dir}/${APP_DB_FILENAME}"
    elif [[ "$source" == *.tar.gz ]]; then
        log_info "Unpacking database snapshot: ${source}..."
        if ! tar -xzf "$source" -C "$data_dir"; then
            log_error "Failed to unpack database snapshot."
            exit 1
        fi
    else
        log_error "Unknown database source type: ${source}"
        log_error "Supported types: .db, .tar.gz"
        exit 1
    fi

    log_success "Database restored to ${data_dir}/${APP_DB_FILENAME}"
}

# cmd_build_recovery: Assembles a build directory for recovery.
cmd_build_recovery() {
    # Check for help first
    if [[ "${1:-}" == "help" ]] || [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]]; then
        show_build_recovery_help
        exit 0
    fi

    local build_base_dir=$1
    shift

    if [ -z "$build_base_dir" ]; then
        log_error "Usage: $0 build-recovery <build_base_dir> [options]"
        exit 1
    fi

    local with_release=""
    local with_db=""

    # Parse flags manually
    while [[ $# -gt 0 ]]; do
        case $1 in
            --with-release) with_release="$2"; shift 2 ;;
            --with-db) with_db="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    if [ -z "$with_release" ] && [ -z "$with_db" ]; then
        log_error "At least --with-release or --with-db must be specified."
        exit 1
    fi

    local tmp_tools=""
    # The trap will cleanup the tmp_tools dir on function exit.
 	# very tricky behavior of trap:
	#
    # - In bash, when you set multiple trap commands for the same signal (in
    # this case RETURN), each new trap overwrites the previous one rather than
    # adding to it. Make sure to have one trap call
	# 
    # - quotes:
    #   Single quotes - variable expands when trap FIRES
	#       trap 'cleanup_temp_dirs "$release_source_dir" "$tmp_tools"' RETURN
    #   Double quotes - variable expands when trap is SET
    #       trap "rm -rf \"$tmp_tools\"" RETURN  
    #       # Becomes literally: trap "rm -rf \"/tmp/tmp.abc123\"" RETURN
    #
    # - the most tricky thing: trap ... RETURN bubbles up through the call
    # stack like an uncaught exception, that means it triggers after each
    # funcion ends:
    # if Set in cmd_build → fires when cmd_build returns ✅ but Trap persists
    # bubbling → fires AGAIN when main returns ❌ At that point, tmp_tools and
    # release_source_dir are local variables from cmd_build which no longer
    # exist
    #
    # - Best practices  
    #   - always check you have one trap per signal in the function
    #   - always stop bubbling up in the caller of the function with trap
    #       trap - RETURN
    trap 'cleanup_temp_dirs "$tmp_tools"' RETURN

    local project_name
    if ! project_name=$(get_project_name_from_recovery_flags "$with_release" "$with_db"); then
        log_error "Aborting recovery build: Could not determine project name."
        exit 1
    fi

    local version="recovery-$(date +%Y%m%d)" # Default version if not discoverable
    if [ -n "$with_release" ]; then
        local tarball_name=$(basename "$with_release")
        local tar_base="${tarball_name%.tar.gz}"
        version=$(get_version_from_file_base "$tar_base")
    fi

    local build_dir="${build_base_dir}/${project_name}-${version}"
    local bin_dir
    bin_dir=$(get_bin_dir "$build_dir")
    local data_dir
    data_dir=$(get_data_dir "$build_dir")

    log_info "Recovery Build for project: ${GREEN}${project_name}${NC} version: ${GREEN}${version}${NC}"
    recreate_build_dir "$build_dir"

    # 1. Handle Release Unpacking
    if [ -n "$with_release" ]; then
        cmd_unpack "$with_release" "$build_dir"
    fi

    # 2. Handle Database Restoration
    if [ -n "$with_db" ]; then
        cmd_restore_db "$with_db" "$build_dir"
        
        # Look for the age key in the same dir as the db source
        local source_dir=$(dirname "$with_db")
        if [ -f "${source_dir}/${AGE_KEY_FILENAME}" ]; then
            log_info "Found ${AGE_KEY_FILENAME} in database source directory. Copying..."
            cp "${source_dir}/${AGE_KEY_FILENAME}" "$build_dir/"
            log_success "Copied ${AGE_KEY_FILENAME} to ${build_dir}/${AGE_KEY_FILENAME}"
        fi
    fi

    # ---------------------------------------------------------
    # DB Integrity Check
    # ---------------------------------------------------------
    if ls "${data_dir}"/*.db >/dev/null 2>&1; then
        log_info "Performing integrity check on databases in data/ directory..."
        
        # Ensure we have a clean tools directory for sqlite (HOST tools)
        tmp_tools=$(mktemp -d)
        download_sqlite "$tmp_tools"

        for db_file in "${data_dir}"/*.db; do
            [ -e "$db_file" ] || continue
            log_info "Checking integrity of: $(basename "$db_file")"
            local check_result
            check_result=$("${tmp_tools}/sqlite3" "$db_file" "PRAGMA integrity_check;")
            echo "$check_result"
            if [[ "$check_result" != "ok" ]]; then
                log_error "Database integrity check failed for ${db_file}!"
                exit 1
            fi
        done
        log_success "All database integrity checks passed."
    fi

    # 3. Ensure self-contained script
    generate_remote_script "$project_name" "${bin_dir}/ripdep-remote"
    log_info "Generated remote deploy script to ${bin_dir}/ripdep-remote"

    log_success "Recovery build completed successfully in: ${GREEN}${build_dir}${NC}"

    echo "" # Add a blank line for readability
    log_info "Next steps:"
    log_info "  To deploy this build to a remote host (includes packing):"
    log_info "    $0 deploy <host> ${build_dir}"
    log_info "  To package this build into a release artifact:"
    log_info "    $0 pack ${build_dir}"
}

# ============================================ 
# DEPLOYMENT FUNCTIONS - REMOTE TRANSFER
# ============================================ 

# cmd_push: Transfers and extracts a release tarball to a remote host.
#
# Design Insight:
# This function is the transport layer of the deployment pipeline. It takes a local
# tarball created by 'pack' and places it on a remote server, preparing it for
# installation.
#
# The core design is to stage the release in a temporary, version-specific
# directory on the remote host (e.g., /tmp/my-project/v1.2.3). This is a deliberate
# choice to ensure that the push operation is non-destructive and isolated from any
# currently running version of the service. The actual "go-live" switch happens
# later during the 'install' step, which allows this 'push' step to be safe to run
# and re-run.
#
# It can be used as a standalone command for manual, step-by-step deployments, in
# which case it provides helpful instructions for the next step ('install'). It
# can also be used as a building block by the parent 'deploy' command, which
# suppresses the instructional output for a cleaner, fully-automated workflow.
cmd_push() {
    local host=${1:-}
    local tarball_path=${2:-}

    if [ -z "$host" ] || [ -z "$tarball_path" ]; then
        log_error "Usage: $0 push <host> <tarball_path>"
        exit 1
    fi

    if [ ! -f "$tarball_path" ]; then
        log_error "Tarball not found at: ${tarball_path}"
        exit 1
    fi
    
    local remote_dir
    if ! remote_dir=$(get_remote_dir_from_tarball_path "$tarball_path"); then
        log_error "Aborting push: Could not determine remote directory."
        exit 1
    fi
    local tarball_name
    tarball_name=$(basename "$tarball_path")

    log_info "Uploading ${tarball_path} to ${host}:${remote_dir}..."
    
    # Create remote directory
    ssh -o LogLevel=ERROR "${host}" "mkdir -p ${remote_dir}"
    
    # Upload tarball
    scp "$tarball_path" "${host}:${remote_dir}/"
    
    # Extract on remote
    log_info "Extracting on remote..."

	#maybe delete the tarball after succesful extract?
	# rm -f ${remote_dir}/${tarball_name}

	if ! ssh -o LogLevel=ERROR "${host}" "
        if tar -xzf ${remote_dir}/${tarball_name} -C ${remote_dir}; then
            exit 0
        else
            echo 'Extraction failed, cleaning up...' >&2
            exit 1
        fi
    "; then
        log_error "Failed to extract tarball on remote host"
        exit 1
    fi
    
    log_success "Uploaded and extracted to ${remote_dir}"
    
    if [ -z "${CMD_DEPLOY_CALLER:-}" ]; then
        echo "" # Add a blank line for readability
        log_info "Next step: Log in to the remote machine and run the installer:"
        log_info "    ssh ${host}"
        log_info "    sudo ${remote_dir}/${APP_BIN_DIRNAME}/ripdep-remote install"
    fi
}

# ============================================ 
# REMOTE SCRIPT GENERATOR
# ============================================ 

generate_remote_script() {
    local project_name=$1
    local output_path=$2

    # The remote script needs the canonical app layout constants, but its body
    # is a quoted heredoc so local variables do not expand inside it. Emit the
    # constants as an expanding preamble, then append the quoted body.
    {
        echo "#!/bin/bash"
        echo "set -euo pipefail"
        echo ""
        echo "# Canonical app names (mirrors the parent script)."
        printf 'PROJECT_NAME=%q\n' "$project_name"
        echo "APP_BIN_DIRNAME=\"${APP_BIN_DIRNAME}\""
        echo "APP_DATA_DIRNAME=\"${APP_DATA_DIRNAME}\""
        echo "APP_LOGS_DIRNAME=\"${APP_LOGS_DIRNAME}\""
        echo "AGE_KEY_FILENAME=\"${AGE_KEY_FILENAME}\""
        echo "SYSTEMD_FILENAME_TEMPLATE=\"${SYSTEMD_FILENAME_TEMPLATE}\""
        cat <<'EOF'

# Colors for output
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'
NC=$'\033[0m' # No Color

# --- Utility Functions ---
log_info() { echo -e "🌐 ${BLUE}→${NC} $1"; }
log_success() { echo -e "🌐 ${GREEN}✓${NC} $1"; }
log_warning() { echo -e "🌐 ${YELLOW}⚠${NC} $1"; }
log_error() { echo -e "🌐 ${RED}✗${NC} $1" >&2; }

require_root() {
    if [ $EUID -ne 0 ]; then
        log_error "This command must run as root (use sudo)"
        exit 1
    fi
}

# --- UNINSTALL HELPERS ---

show_uninstall_help() {
    cat <<HELPEOF
${GREEN}ripdep uninstall${NC} - Uninstall the project on a VM.

Usage: $0 uninstall [project-name]

HELPEOF
}

stop_service() {
    local project_name=$1
    log_info "Stopping and disabling service '${project_name}'..."
    # 'systemctl cat' is a reliable existence probe; 'list-unit-files' is not.
    if systemctl cat "${project_name}.service" >/dev/null 2>&1; then
        if systemctl is-active --quiet "${project_name}"; then
            log_info "→ Service is active. Stopping..."
            systemctl stop "${project_name}"
        fi
        if systemctl is-enabled --quiet "${project_name}"; then
            log_info "→ Service is enabled. Disabling..."
            systemctl disable "${project_name}"
        fi
    else
        log_warning "→ Service ${project_name}.service not found, skipping stop/disable."
    fi
    log_success "Service stop/disable phase finished."
}

remove_systemd_service() {
    local project_name=$1
    local service_path="/etc/systemd/system/${project_name}.service"
    log_info "Deleting systemd service file for '${project_name}'..."
    if [ -f "${service_path}" ]; then
        log_info "→ Removing systemd service file: ${service_path}"
        rm -f "${service_path}"
        systemctl daemon-reload
    else
        log_warning "→ Service file ${service_path} not found."
    fi
    log_success "Systemd file cleanup finished."
}

delete_service_user() {
    local project_name=$1
    log_info "Deleting user and all files for '${project_name}'..."
    if id "${project_name}" &>/dev/null; then
        log_info "→ Deleting user '${project_name}' and home directory..."
        userdel -r "${project_name}"
    else
        log_warning "→ User ${project_name} not found."
    fi
    log_success "User and files cleanup finished."
}

# --- INSTALL HELPERS ---

create_service_user() {
    local project_name=$1
    log_info "Setting up service user: ${project_name}..."
    if id "${project_name}" &>/dev/null; then
        log_success "User ${project_name} already exists"
        return 0
    fi
    useradd -r -m -d "/home/${project_name}" -s /bin/bash "${project_name}"
    log_success "Created user ${project_name}"
}

create_directory_structure() {
    local project_name=$1
    log_info "Creating directory structure..."
    local data_dir="/home/${project_name}/${APP_DATA_DIRNAME}"
    local dirs=( "/home/${project_name}/${APP_BIN_DIRNAME}" "$data_dir" "/home/${project_name}/${APP_LOGS_DIRNAME}" )
    for dir in "${dirs[@]}"; do
        if [ ! -d "$dir" ]; then
            mkdir -p "$dir"
            log_success "Created $dir"
        fi
    done
    chmod 700 "$data_dir"
    log_success "Set permissions for ${data_dir} to 700"
    chown -R "${project_name}:${project_name}" "/home/${project_name}"
}

deploy_binaries() {
    local project_name=$1
    local source_dir=$2
    log_info "Deploying binaries from ${source_dir}/${APP_BIN_DIRNAME}..."
    if [ ! -d "${source_dir}/${APP_BIN_DIRNAME}" ]; then
        log_error "No bin/ directory found in ${source_dir}"
        exit 1
    fi
    for binary in "${source_dir}/${APP_BIN_DIRNAME}"/*; do
        if [ -f "$binary" ]; then
            local basename=$(basename "$binary")
            # This loop now also installs the ripdep-remote script itself,
            # making it available for future undeploy commands.
            install -m 700 -o "${project_name}" -g "${project_name}" \
                "$binary" "/home/${project_name}/${APP_BIN_DIRNAME}/${basename}"
            log_success "Installed binary: ${basename} to /home/${project_name}/${APP_BIN_DIRNAME}/${basename}"
        fi
    done
}

deploy_data_files() {
    local project_name=$1
    local source_dir=$2
    log_info "Deploying data files from ${source_dir}/${APP_DATA_DIRNAME}..."
    if [ -f "${source_dir}/${AGE_KEY_FILENAME}" ]; then
        local dest_key="/home/${project_name}/${AGE_KEY_FILENAME}"
        install -m 600 -o "${project_name}" -g "${project_name}" \
            "${source_dir}/${AGE_KEY_FILENAME}" "$dest_key"
        log_success "Installed ${AGE_KEY_FILENAME} to $dest_key"
    fi
    if [ ! -d "${source_dir}/${APP_DATA_DIRNAME}" ]; then
        return 0
    fi
    for datafile in "${source_dir}/${APP_DATA_DIRNAME}"/*; do
        if [ -f "$datafile" ]; then
            local basename=$(basename "$datafile")
            local dest="/home/${project_name}/${APP_DATA_DIRNAME}/${basename}"
            install -m 600 -o "${project_name}" -g "${project_name}" \
                "$datafile" "$dest"
            log_success "Installed data file: ${basename} to $dest"
        fi
    done
}

deploy_systemd_service() {
    local project_name=$1
    local source_dir=$2
    log_info "Deploying systemd service..."
    local conf_filename
    printf -v conf_filename "$SYSTEMD_FILENAME_TEMPLATE" "$project_name"
    local service_file=$(find "${source_dir}" -name "$conf_filename" | head -n 1)
    if [ -z "$service_file" ]; then
        log_warning "No service file in ${source_dir}; keeping the installed unit."
        return 0
    fi
    cp "$service_file" "/etc/systemd/system/${project_name}.service"
    systemctl daemon-reload
    log_success "Deployed ${project_name}.service to /etc/systemd/system/${project_name}.service"
}

handle_database() {
    # Placeholder for future logic
    :
}

# --- Main Remote Commands ---

cmd_install() {
    require_root
    
    # The project name is baked in at build time, so the installer, the
    # rendered systemd unit, and the service user all agree on the name.
    local project_name="${PROJECT_NAME}"

    # The payload (bin/, data/, unit file) sits two levels above this script.
    local script_path
    script_path=$(realpath "$0")
    local source_dir
    source_dir=$(dirname "$(dirname "$script_path")")

    log_info "Installing service '${project_name}' from source '${source_dir}'..."
    
    create_service_user "$project_name"
    create_directory_structure "$project_name"
    deploy_binaries "$project_name" "$source_dir"
    deploy_data_files "$project_name" "$source_dir"
    deploy_systemd_service "$project_name" "$source_dir"
    handle_database
    
    log_success "Installation complete!"
    log_info "To start service: systemctl enable --now ${project_name}"
}

cmd_uninstall() {
    require_root
    local project_name=${1:-$PROJECT_NAME}
    if [ -z "$project_name" ]; then
        show_uninstall_help
        exit 1
    fi
    log_info "Uninstalling service '${project_name}'..."
    stop_service "$project_name"
    remove_systemd_service "$project_name"
    delete_service_user "$project_name"
    log_success "Successfully uninstalled '${project_name}'."
}

# --- Main Entry Point for Remote Script ---

main() {
    local cmd=${1:-}
    if [ -z "$cmd" ]; then
        echo "Usage: $0 <install|uninstall> [ARGS...]"
        exit 1
    fi
    shift
    case "$cmd" in
        install) cmd_install "$@" ;;
        uninstall) cmd_uninstall "$@" ;;
        *) log_error "Unknown command: $cmd"; exit 1 ;;
    esac
}

main "$@"

EOF
    } > "$output_path"

    # Make the generated script executable
    chmod +x "$output_path"
}



cmd_deploy() {
    local host=${1:-}
    local build_dir=${2:-}

    if [ -z "$host" ] || [ -z "$build_dir" ]; then
        log_error "Usage: $0 deploy <host> <build_dir> [install-options...]"
        exit 1
    fi

    shift 2 # Consume the host and build_dir arguments
    local install_args="$*" # The rest are options for the remote install command

    # --- Step 1: Pack the application ---
    log_info "Step 1: Packing application locally..."
    CMD_DEPLOY_CALLER=true cmd_pack "$build_dir"

    # --- Step 2: Determine the tarball path ---
    local build_name
    build_name=$(basename "$build_dir")
    
    local project_name
    project_name=$(get_project_name_from_file_base "$build_name")
    
    local tarball_name="${build_name}.tar.gz"
    local tarball_path="${RELEASES_BASE_DIR}/${project_name}/${tarball_name}"
    log_info "Determined tarball path: $tarball_path"
    
    # --- Step 3: Push the application ---
    log_info "Step 3: Pushing application to ${host}..."
    CMD_DEPLOY_CALLER=true cmd_push "$host" "$tarball_path"

    # --- Step 4: Install on the remote server ---
    log_info "Step 4: Installing application on ${host}..."
    
    local remote_dir
    if ! remote_dir=$(get_remote_dir_from_tarball_path "$tarball_path"); then
        log_error "Aborting deployment: Could not determine remote directory."
        exit 1
    fi

    ssh -t -o LogLevel=ERROR "${host}" "sudo ${remote_dir}/${APP_BIN_DIRNAME}/ripdep-remote install ${install_args}"
    
    # --- Step 5: Cleanup ---
    # We perform cleanup from the deployment script (running as the SSH user)
    # rather than the installer (running as root). This avoids the risk of 
    # running 'rm -rf' with elevated privileges on a potentially miscalculated path.
    log_info "Step 5: Cleaning up installation artifacts in ${remote_dir}..."
    ssh -o LogLevel=ERROR "${host}" "rm -rf ${remote_dir}"

    log_success "Deployment complete on ${host}!"
}

# ============================================ 
# UNDEPLOYMENT FUNCTIONS
# ============================================ 



cmd_undeploy() {
    local host=${1:-}
    local project_name=${2:-}
    local force=${3:-} # for -y or --force

    if [ -z "$host" ] || [ -z "$project_name" ]; then
        log_error "Usage: $0 undeploy <host> <project-name> [-y|--force]"
        exit 1
    fi

    if [[ "$force" != "-y" && "$force" != "--force" ]]; then
        log_warning "This will PERMANENTLY DELETE the service '${project_name}', its user, and all associated files from '${host}'."
        log_warning "This action cannot be undone. Consider creating a backup first with the 'backup' command."
        read -p "Are you sure you want to continue? (yes/no) " -r
        echo
        if [[ ! "$REPLY" =~ ^[Yy][Ee][Ss]$ ]]; then
            log_info "Undeploy cancelled."
            exit 1
        fi
    fi

    log_info "Uninstalling application on ${host}..."
    local deployed_script_path="/home/${project_name}/${APP_BIN_DIRNAME}/ripdep-remote"
    log_info "→ Orchestrating remote uninstall using the deployed script..."

    # The script can safely delete itself (via userdel -r inside the uninstall command)
    # because the shell reads the script into memory upon execution.
    local uninstall_script="set -e
echo '→ Executing uninstaller...'
sudo ${deployed_script_path} uninstall ${project_name}"
    
    if ! ssh -t -o LogLevel=ERROR "${host}" "$uninstall_script"; then
        log_warning "Remote uninstall script failed. The server may be in an inconsistent state."
        exit 1
    fi
    
    log_success "Successfully undeployed '${project_name}' from '${host}'."
}

# ============================================ 
# OPERATIONAL COMMANDS
# ============================================ 

cmd_maintenance() {
    local host=${1:-}
    local project_name=${2:-}
    local state=${3:-} # true | false

    if [ -z "$host" ] || [ -z "$project_name" ] || [ -z "$state" ]; then
        log_error "Usage: $0 maintenance <host> <project-name> <true|false>"
        exit 1
    fi

    if [[ "$state" != "true" && "$state" != "false" ]]; then
        log_error "Invalid maintenance state: '${state}'. Use 'true' or 'false'."
        exit 1
    fi

    local key_path="/home/${project_name}/${AGE_KEY_FILENAME}"
    local db_path="/home/${project_name}/${APP_DATA_DIRNAME}/${APP_DB_FILENAME}"
    local ripc_bin="/home/${project_name}/${APP_BIN_DIRNAME}/ripc"

    log_info "Setting maintenance mode to '${state}' on host '${host}' for project '${project_name}'..."

    # One ssh call: flip the flag as the project user, then reload; -t lets sudo prompt if needed.
    if ! ssh -t -o LogLevel=ERROR "${host}" "
        sudo -u ${project_name} ${ripc_bin} -agekey ${key_path} -dbpath ${db_path} set maintenance.activated ${state} &&
        sudo systemctl reload ${project_name}
    "; then
        log_error "Failed to set maintenance mode on ${host}."
        exit 1
    fi
    
    log_success "Successfully set maintenance mode to '${state}' for '${project_name}' on '${host}'."
}

# TODO: consider deleting cmd_config; cmd_shell covers interactive remote ripc
# use, and scripted one-shot remote ripc calls have no clear use case yet.
cmd_config() {
    local host=${1:-}
    local project_name=${2:-}

    if [ -z "$host" ] || [ -z "$project_name" ]; then
        log_error "Usage: $0 config <host> <project-name> [ripc-args...]"
        exit 1
    fi
    shift 2
    local args="$*"

    local key_path="/home/${project_name}/${AGE_KEY_FILENAME}"
    local db_path="/home/${project_name}/${APP_DATA_DIRNAME}/${APP_DB_FILENAME}"
    local ripc_bin="/home/${project_name}/${APP_BIN_DIRNAME}/ripc"
    
    ssh -t -o LogLevel=ERROR "${host}" "sudo -u ${project_name} ${ripc_bin} -agekey ${key_path} -dbpath ${db_path} $args"
}

cmd_shell() {
    local host=${1:-}
    local project_name=${2:-}

    if [ -z "$host" ] || [ -z "$project_name" ]; then
        log_error "Usage: $0 shell <host> <project-name>"
        exit 1
    fi

    log_info "Opening a shell as '${project_name}' on ${host}..."
    log_info "Inside, use 'ripc' to modify configuration, e.g.:"
    log_info "    ripc set server.port 8080"

    # sudo -iu resets the environment and would drop the injected variables,
    # so -H gives bash the project user's HOME and env plants them before it starts.
    ssh -t -o LogLevel=ERROR "${host}" \
        "sudo -H -u ${project_name} env \
         PATH=/home/${project_name}/${APP_BIN_DIRNAME}:/usr/local/bin:/usr/bin:/bin \
         RIPC_DB=/home/${project_name}/${APP_DATA_DIRNAME}/${APP_DB_FILENAME} \
         RIPC_AGE_KEY_PATH=/home/${project_name}/${AGE_KEY_FILENAME} \
         PROJECT_NAME=${project_name} \
         bash -l"
}

cmd_status() {
    local host=${1:-}
    local project_name=${2:-}
    if [ -z "$host" ] || [ -z "$project_name" ]; then
        log_error "Usage: $0 status <host> <project-name>"
        exit 1
    fi
    ssh -t -o LogLevel=ERROR "${host}" "systemctl status ${project_name} --no-pager"
}

cmd_logs() {
    local host=${1:-}
    local project_name=${2:-}
    local lines=${3:-50}
    if [ -z "$host" ] || [ -z "$project_name" ]; then
        log_error "Usage: $0 logs <host> <project-name> [lines]"
        exit 1
    fi
    ssh -t -o LogLevel=ERROR "${host}" "journalctl -u ${project_name} -n $lines -f"
}

cmd_restart() {
    local host=${1:-}
    local project_name=${2:-}
    if [ -z "$host" ] || [ -z "$project_name" ]; then
        log_error "Usage: $0 restart <host> <project-name>"
        exit 1
    fi
    ssh -t -o LogLevel=ERROR "${host}" "sudo systemctl restart ${project_name}"
    log_success "Restart command sent"
}

cmd_db_status() {
    local host=${1:-}
    local project_name=${2:-}
    if [ -z "$host" ] || [ -z "$project_name" ]; then
        log_error "Usage: $0 db-status <host> <project-name>"
        exit 1
    fi
    log_info "Checking database status on ${host}..."
    ssh -t -o LogLevel=ERROR "${host}" "ls -lh /home/${project_name}/${APP_DATA_DIRNAME}/*.db"
}

cmd_backup() {
    local host=${1:-}
    local project_name=${2:-}

    if [ -z "$host" ] || [ -z "$project_name" ]; then
        log_error "Usage: $0 backup <host> <project-name>"
        exit 1
    fi

    local backup_name="${project_name}-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
    local remote_backup_path="/tmp/${backup_name}"

    log_info "Starting backup for '${project_name}' from '${host}'..."
    log_info "Creating remote tarball at ${remote_backup_path}..."

    # Consolidate remote operations: check, create, chown
    # We chown to the current user ($USER) so scp can read it without root
    if ! ssh -t -o LogLevel=ERROR "${host}" "
        if [ ! -d '/home/${project_name}' ]; then
            echo 'Home directory not found' >&2
            exit 2
        fi
        sudo tar -czf '${remote_backup_path}' -C '/home/${project_name}' . && \
        sudo chown \$(whoami) '${remote_backup_path}'
    "; then
        local exit_code=$?
        if [ $exit_code -eq 2 ]; then
            log_info "No data or logs found in /home/${project_name}, skipping backup."
            return 0
        else
            log_error "Failed to create remote backup. Aborting."
            exit 1
        fi
    fi

    log_info "Downloading backup from ${host}:${remote_backup_path}..."
    if ! scp "${host}:${remote_backup_path}" "./${backup_name}"; then
        log_error "Download failed."
        exit 1
    fi
    log_success "Backup saved locally to: ${PWD}/${backup_name}"

    log_info "Cleaning up remote backup file..."
    ssh -t -o LogLevel=ERROR "${host}" "rm -f '${remote_backup_path}'"
    log_success "Backup command finished."
}

# ============================================ 
# HELP AND MAIN ENTRY POINT
# ============================================ 

show_help() {
    cat <<EOF
${GREEN}ripdep${NC} - Deployment and operations tool

Usage: $0 <COMMAND> [ARGS...]

Commands:
  build-release <build_dir> <project_path>   Build a release artifact from source code.
  build-bootstrap <build_dir> <project_path> Build a bootstrap artifact from source code.
  build-recovery <build_dir> [opts]          Build an artifact from backups (recovery).
  unpack <tarball> <dir>                     Extract a release tarball into a directory.
  restore <source> <dir>                     Restore a database into a directory.
  pack <build_dir>                           Package a build directory into a tarball.
  push <host> <tarball_path>                 Upload a specific tarball to a VM.
  install [opts]                             Install on VM (run remotely).
  deploy <host> <build_dir> [opts]           Build, pack, push, and install in one command.
  undeploy <host> <project-name>             Permanently remove a project and all its data from a host.
  backup <host> <project-name>               Creates and downloads a backup of a project.
  maintenance <host> <project-name> <true|false> Toggle maintenance mode for a project.
  config <host> <project-name> [args]        Run ripc commands on a remote host.
  shell <host> <project-name>                Open an interactive shell as the project user on a VM.
  status <host> <project-name>               Check service status on a remote host.
  logs <host> <project-name> [lines]         Tail service logs from a remote host.
  restart <host> <project-name>              Restart the service on a remote host.
  db-status <host> <project-name>            Check database status on a remote host.

EOF
}

show_build_release_help() {
    cat <<EOF
${GREEN}ripdep build-release${NC} - Build a release artifact from source.

Usage: $0 build-release <build-base-dir> <project-path>

Arguments:
  <build-base-dir>  The base directory where the build output will be created.
  <project-path>     Path to the project source code to compile.

EOF
}

show_build_bootstrap_help() {
    cat <<EOF
${GREEN}ripdep build-bootstrap${NC} - Build a bootstrap artifact from source.

Usage: $0 build-bootstrap <build-base-dir> <project-path>

Arguments:
  <build-base-dir>  The base directory where the build output will be created.
  <project-path>     Path to the project source code to compile.

Description:
  Similar to build-release, but also copies the project's existing database
  and ${AGE_KEY_FILENAME} into the build and adds the systemd service
  configuration. Both files must already exist in the project directory;
  the key is never generated or downloaded and the database is never created.
  The build fails if either is missing.

EOF
}

show_build_recovery_help() {
    cat <<EOF
${GREEN}ripdep build-recovery${NC} - Build an artifact from backups.

Usage: $0 build-recovery <build-dir> [options]

Options:
  --with-release <path>      Path to an existing release tarball (.tar.gz).
  --with-db <source>         Database file (.db) or compressed backup (.tar.gz).

EOF
}

show_install_help() {
    cat <<EOF
${GREEN}ripdep install${NC} - Install the service on a VM.

Usage: $0 install [options]

Options:
  --restore-from-backup      (Legacy flag, placeholder for future logic).

EOF
}

show_uninstall_help() {
    cat <<EOF
${GREEN}ripdep uninstall${NC} - Uninstall the service on a VM.

Usage: $0 uninstall <project-name>

EOF
}

# get_project_name_from_project_path: Determines project name from the project path argument.
get_project_name_from_project_path() {
    local with_project="$1"

    if [ -n "$with_project" ]; then
        echo "$(basename "$with_project")"
        return 0
    fi

    log_error "Could not determine project name; project path argument is missing."
    return 1
}

# get_project_name_from_recovery_flags: Determines project name from recovery arguments
get_project_name_from_recovery_flags() {
    local with_release="$1"
    local with_db="$2"

    if [ -n "$with_release" ]; then
        local tarball_name=$(basename "$with_release")
        local tar_base="${tarball_name%.tar.gz}"
        echo "$(get_project_name_from_file_base "$tar_base")"
        return 0
    fi

    if [ -n "$with_db" ]; then
        echo "$(basename "$(dirname "$with_db")")"
        return 0
    fi

    log_error "Could not determine project name from recovery flags."
    return 1
}


cleanup_temp_dirs() {
    local exit_code=$?
    log_info "Cleanup triggered from trap call (exit code: $exit_code)"

    # Log incoming parameters
    local param_count=$#
    log_info "  Received $param_count parameter(s)"

    if [ $param_count -eq 0 ]; then
        log_info "  No directories to clean up"
    fi

    # Clean up directories
    for dir in "$@"; do
        if [ -n "$dir" ] && [ -d "$dir" ]; then
            rm -rf "$dir"
            log_success "  Cleaned up: $dir"
        fi
    done

    return $exit_code
}

# cmd_build_release: Builds a standard release artifact from source code.
#
# This command is used for updating an existing application with a new version of the code.
# It compiles the Go binary and includes the necessary tools (`ripc`, `ripdep`)
# but does *not* create a new database or encryption keys, ensuring that existing data is preserved on deployment.
cmd_build_release() {
    # Check for help first
    if [[ "${1:-}" == "help" ]] || [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]]; then
        show_build_release_help
        exit 0
    fi

    if [ "$#" -ne 2 ]; then
        log_error "Usage: $0 build-release <build-base-dir> <project-path>"
        exit 1
    fi
    local build_base_dir=$1
    local project_path=$2

    log_info "Creating a new release build..."

    if ! is_go_project "$project_path"; then
        log_error "Validation failed: Not a valid Go project."
        exit 1
    fi

    local project_name
    if ! project_name=$(get_project_name_from_project_path "$project_path"); then
        log_error "Aborting build: Could not determine project name."
        exit 1
    fi

    local version
    if ! version=$(cd "$project_path" && get_latest_tag); then
        log_error "Could not determine version for project: ${project_path}"
        exit 1
    fi

    if ! require_clean_worktree "$project_path"; then
        exit 1
    fi

    local build_dir="${build_base_dir}/${project_name}-${version}"
    local bin_dir
    bin_dir=$(get_bin_dir "$build_dir")
    local data_dir
    data_dir=$(get_data_dir "$build_dir")
    recreate_build_dir "$build_dir"

    log_info "Build configuration:"
    log_info "  Build base directory       : $build_base_dir"
    log_info "  Build project directory    : $build_dir"
    log_info "  Project path               : ${project_path}"
    log_info "  Project name               : ${GREEN}$project_name${NC}"
    log_info "  Project version            : ${GREEN}$version${NC}"
    log_info "  Host OS/Arch               : ${GREEN}$HOST_GOOS/$HOST_GOARCH${NC}"
    log_info "  Target OS/Arch             : ${GREEN}$TARGET_GOOS/$TARGET_GOARCH${NC}"
    log_info ""
    
    # Build project binary, naming it after the project
    build_project_binary "$bin_dir" "$project_path" "$project_name"

    # Generate the remote script to make the artifact self-contained
    generate_remote_script "$project_name" "${bin_dir}/ripdep-remote"
    log_info "Generated remote deploy script to ${bin_dir}/ripdep-remote"

    log_info "Building release tools (ripc)..."
    build_ripc "$bin_dir" "$project_path"

    log_success "Release build completed successfully in: ${GREEN}${build_dir}${NC}"

    echo "" # Add a blank line for readability
    log_info "Next steps:"
    log_info "  To deploy this build to a remote host (includes packing):"
    log_info "    $0 deploy <host> ${build_dir}"
    log_info "  To package this build into a release artifact:"
    log_info "    $0 pack ${build_dir}"
}

cmd_build_bootstrap() {
    # Check for help first
    if [[ "${1:-}" == "help" ]] || [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]]; then
        show_build_bootstrap_help
        exit 0
    fi

    if [ "$#" -ne 2 ]; then
        log_error "Usage: $0 build-bootstrap <build-base-dir> <project-path>"
        exit 1
    fi
    local build_base_dir=$1
    local project_path=$2


    log_info "Creating a new bootstrap build..."

    if ! is_go_project "$project_path"; then
        log_error "Validation failed: Not a valid Go project."
        exit 1
    fi

    local project_name
    if ! project_name=$(get_project_name_from_project_path "$project_path"); then
        log_error "Aborting bootstrap: Could not determine project name."
        exit 1
    fi

    local version
    if ! version=$(cd "$project_path" && get_latest_tag); then
        log_error "Could not determine version for project: ${project_path}"
        exit 1
    fi

    if ! require_clean_worktree "$project_path"; then
        exit 1
    fi

    local build_dir="${build_base_dir}/${project_name}-${version}"
    local bin_dir
    bin_dir=$(get_bin_dir "$build_dir")
    local data_dir
    data_dir=$(get_data_dir "$build_dir")
    recreate_build_dir "$build_dir"

    log_info "Build configuration:"
    log_info "  Build base directory       : $build_base_dir"
    log_info "  Build project directory    : $build_dir"
    log_info "  Project path               : ${project_path}"
    log_info "  Project name               : ${GREEN}$project_name${NC}"
    log_info "  Project version            : ${GREEN}$version${NC}"
    log_info "  Host OS/Arch               : ${GREEN}$HOST_GOOS/$HOST_GOARCH${NC}"
    log_info "  Target OS/Arch             : ${GREEN}$TARGET_GOOS/$TARGET_GOARCH${NC}"
    log_info ""
    
    # -------------------------------------------------------------
    # 1. Bootstrap application data from existing project
    # -------------------------------------------------------------
    log_info "Bootstrapping application data..."

    copy_age_key "$project_path" "$build_dir"
    copy_project_db "$project_path" "$project_name" "$data_dir"

    # -------------------------------------------------------------
    # 2. Add systemd service configuration
    # -------------------------------------------------------------
    create_systemd_conf "$project_name" "$project_path" "$build_dir"

    # -------------------------------------------------------------
    # 3. Assemble Target Payload (for remote deployment)
    # -------------------------------------------------------------
    log_info "Building and assembling target artifacts ($TARGET_GOOS/$TARGET_GOARCH)..."
    
    # Build project binary, naming it after the project
    build_project_binary "$bin_dir" "$project_path" "$project_name"

    # Generate the remote script to make the artifact self-contained
    generate_remote_script "$project_name" "${bin_dir}/ripdep-remote"
    log_info "Generated remote deploy script to ${bin_dir}/ripdep-remote"

    log_info "Building target release tools (ripc)..."
    build_ripc "$bin_dir" "$project_path"

    log_success "Bootstrap build completed successfully in: ${GREEN}${build_dir}${NC}"

    echo "" # Add a blank line for readability
    log_info "Next steps:"
    log_info "  To deploy this build to a remote host (includes packing):"
    log_info "    $0 deploy <host> ${build_dir}"
    log_info "  To package this build into a release artifact:"
    log_info "    $0 pack ${build_dir}"
}

# ============================================ 
# HOOKS 
# ============================================ 
# Usage:
# 	exec_hook "dns-update" "_dns_update_noop" "$source" "$target" "$domain"
# No fallback needed - hook is required
# 	exec_hook "db-replicate" "" "$source" "$target" || exit 1
exec_hook() {
    local hook_name=$1
    local fallback_func=$2
    shift 2
    
    if [ -x "${HOOKS_DIR}/${hook_name}" ]; then
        "${HOOKS_DIR}/${hook_name}" "$@"
        return $?
    fi
    
    if [ -n "$fallback_func" ] && declare -f "$fallback_func" > /dev/null 2>&1; then
        "$fallback_func" "$@"
        return $?
    fi
    
    return 0
}



# Update the main function's case statement to include build:
# build dir are ephemeral
# backup dirs are authoritative
# project files are authoritative
# install just copies and validates agains requird state at the end, it fails if invalud
main() {
    local cmd=${1:-}
    
    if [ -z "$cmd" ]; then show_help; exit 0; fi
    shift
    
    case "$cmd" in
        build-release) cmd_build_release "$@" ;;
        build-bootstrap) cmd_build_bootstrap "$@" ;;
        build-recovery) cmd_build_recovery "$@" ;;
        unpack) cmd_unpack "$@" ;;
        restore) cmd_restore_db "$@" ;;
        pack) cmd_pack "$@" ;; 
        push) cmd_push "$@" ;; 
        deploy) cmd_deploy "$@" ;; 
        undeploy) cmd_undeploy "$@" ;;
        backup) cmd_backup "$@" ;;
        maintenance) cmd_maintenance "$@" ;; 
        config) cmd_config "$@" ;; 
        shell) cmd_shell "$@" ;; 
        status) cmd_status "$@" ;; 
        logs) cmd_logs "$@" ;; 
        restart) cmd_restart "$@" ;; 
        db-status) cmd_db_status "$@" ;; 
        help|--help|-h) show_help ;; 
        *) log_error "Unknown command: $cmd"; show_help; exit 1 ;; 
    esac

	# Unset traps so it doesn't fire again when main() returns
    #
    # trap RETURN bubbles up through the call stack like an uncaught exception,
    # that means it triggers after each funcion ends:
    #
    # - Best practices  
    #   - always check one trap per signal
    #   - always stop bubbling up in the caller of the function with the trap
    #       trap - RETURN
    trap - RETURN
}

main "$@"
